# Copy to build-mac-remote.env in this folder (same directory as build-mac-remote.sh).
# Never commit build-mac-remote.env — it contains your Mac SSH password.
#
# Re-run with --configure to change saved values.

export MAC_BUILD_HOST="192.168.6.54"
export MAC_BUILD_USER="macbook"
export MAC_BUILD_PASSWORD="your-mac-login-password"

# Directory on the Mac (relative to $HOME, or an absolute path).
export MAC_BUILD_REMOTE_DIR="theos_remote/LiquidGlass"

# Theos on the Mac (leave empty to use $HOME/theos on the Mac).
# export MAC_BUILD_THEOS="/Users/you/theos"

# rootless | roothide
export MAC_BUILD_SCHEME="rootless"

# Set to 1 to skip "make clean" before package (recommended for remote builds).
export MAC_BUILD_SKIP_CLEAN="1"

# Test device install uses theos-device.env (copy from ../theos-device.env.example).
# Or run: ./build-mac-remote.sh --configure-device
