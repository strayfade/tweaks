<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LiquidGlass.plist  –  Substrate / ElleKit load filter
  SpringBoard and Settings only — do not inject into third-party or other system apps.
-->
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <string>com.apple.springboard</string>
            <string>com.apple.Preferences</string>
        </array>
    </dict>
</dict>
</plist>
